FROM python:3.11-slim-bookworm

RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps git \
 && rm -rf /var/lib/apt/lists/*

# PySpark trae spark-submit. El conector Kafka se baja con --packages (ver README).
RUN pip install --no-cache-dir pyspark==3.5.3 kafka-python==2.0.2 pymongo

ENV SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.3
WORKDIR /workspace
